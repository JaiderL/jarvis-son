{
  "version": 1,
  "perfil_activo": "base",

  "binarios": {
    "whisper": "third_party/whisper.cpp/build/bin/whisper-cli",
    "llama": "third_party/llama.cpp/build/bin/llama-completion",
    "sherpa_tts": "third_party/sherpa-onnx/build/bin/sherpa-onnx-offline-tts",
    "ffmpeg": "ffmpeg",
    "grabar": "termux-microphone-record",
    "reproducir": "play-audio",
    "tts_respaldo": "termux-tts-speak"
  },

  "grabacion": {
    "segundos": 6,
    "duracion_min_s": 5.0,
    "duracion_max_s": 8.0,
    "rms_minimo": 50.0,
    "timeout_termux_s": 15
  },

  "tiempos_limite_s": {
    "conversion": 30,
    "stt": 120,
    "slm": 240,
    "tts": 90,
    "reproduccion": 60
  },

  "stt": {
    "prompt_inicial": "Hola Jarvis. Transcripción en español de Colombia, con signos de puntuación."
  },

  "slm": {
    "temperatura": 0.3,
    "prompt_sistema": "Eres Jarvis-son, un asistente de voz. Responde siempre en español latino neutro, de forma breve y clara: máximo dos oraciones cortas, sin listas, sin emojis, sin markdown y sin mostrar razonamiento.",
    "args_extra_llama": []
  },

  "tts": {
    "motor": "sherpa",
    "permitir_respaldo_termux": false
  },

  "respuestas_rapidas": {
    "activado": true,
    "max_palabras": 6,
    "tolerancia_errores": true,
    "reglas": [
      {
        "id": "saludo",
        "modo": "exacta",
        "frases": ["hola", "hola jarvis", "buenas", "buenos dias", "buenas tardes", "buenas noches", "hey jarvis"],
        "respuestas": ["¡Hola! ¿En qué te puedo ayudar?", "¡Hola! Dime, ¿qué necesitas?"]
      },
      {
        "id": "como_estas",
        "modo": "exacta",
        "frases": ["como estas", "hola como estas", "hola jarvis como estas", "que tal", "hola que tal", "como vas"],
        "respuestas": ["Muy bien, gracias. ¿En qué te ayudo?", "¡Todo bien por aquí! ¿Qué necesitas?"]
      },
      {
        "id": "hora",
        "modo": "exacta",
        "frases": ["que hora es", "que horas son", "dime la hora", "me dices la hora", "sabes que hora es", "jarvis que hora es"],
        "respuesta_dinamica": "hora"
      },
      {
        "id": "fecha",
        "modo": "exacta",
        "frases": ["que fecha es hoy", "que dia es hoy", "dime la fecha", "a cuanto estamos hoy"],
        "respuesta_dinamica": "fecha"
      },
      {
        "id": "quien_eres",
        "modo": "exacta",
        "frases": ["quien eres", "como te llamas", "que eres", "quien eres tu"],
        "respuestas": ["Soy Jarvis-son, un asistente de voz que funciona sin internet en este teléfono."]
      },
      {
        "id": "repetir",
        "modo": "exacta",
        "frases": ["repite", "repitelo", "repite por favor", "que dijiste", "no te entendi"],
        "respuesta_dinamica": "ultima_respuesta"
      },
      {
        "id": "gracias",
        "modo": "exacta",
        "frases": ["gracias", "muchas gracias", "gracias jarvis", "listo gracias"],
        "respuestas": ["¡Con gusto!", "¡A la orden!"]
      },
      {
        "id": "despedida",
        "modo": "exacta",
        "frases": ["adios", "chao", "hasta luego", "adios jarvis", "chao jarvis", "eso es todo"],
        "respuestas": ["¡Hasta luego!"],
        "terminar": true
      }
    ],
    "temas_bloqueados": {
      "frases": ["contraseña", "numero de tarjeta", "clave del banco", "codigo de verificacion"],
      "respuesta": "Por seguridad no manejo contraseñas, claves ni datos bancarios."
    }
  },

  "metricas": {
    "archivo": "logs/metricas.csv"
  },

  "perfiles": {
    "base": {
      "descripcion": "Teléfono de 3 GB de RAM",
      "modelo_stt": "models/ggml-tiny.bin",
      "stt_beam": 5,
      "modelo_slm": "models/Qwen3.5-0.8B-Q4_0.gguf",
      "contexto": 1024,
      "salida_tokens": 96,
      "hilos": 4,
      "voz_dir": "models/vits-piper-es_MX-ald-medium",
      "voz_modelo": "es_MX-ald-medium.onnx"
    },
    "alto": {
      "descripcion": "Teléfono con mejores características (6 GB de RAM o más)",
      "modelo_stt": "models/ggml-base.bin",
      "stt_beam": 5,
      "modelo_slm": "models/Qwen3.5-2B-Q4_K_M.gguf",
      "contexto": 2048,
      "salida_tokens": 128,
      "hilos": 6,
      "voz_dir": "models/vits-piper-es_MX-claude-high",
      "voz_modelo": "es_MX-claude-high.onnx"
    }
  }
}
